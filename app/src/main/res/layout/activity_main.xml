<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/simToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <Button
            android:id="@+id/btnSim1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM 1"
            android:textColor="@color/mono_btn_text"
            app:backgroundTint="@color/mono_btn_bg"
            app:strokeColor="#FF000000" />

        <Button
            android:id="@+id/btnSim2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM 2"
            android:textColor="@color/mono_btn_text"
            app:backgroundTint="@color/mono_btn_bg"
            app:strokeColor="#FF000000" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <Button
            android:id="@+id/btnModeSignal"
            style="@style/ModeButton"
            android:text="All" />

        <Button
            android:id="@+id/btnModeNr"
            style="@style/ModeButton"
            android:text="5G" />

        <Button
            android:id="@+id/btnModeLte"
            style="@style/ModeButton"
            android:text="4G" />

        <Button
            android:id="@+id/btnModeWcdma"
            style="@style/ModeButton"
            android:text="3G" />

        <Button
            android:id="@+id/btnModeGsm"
            style="@style/ModeButton"
            android:text="2G" />

        <Button
            android:id="@+id/btnModeTech"
            style="@style/ModeButton"
            android:text="Tech" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:id="@+id/legendRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/legendLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-120"
            android:textColor="#FF000000"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/legend_gradient" />

        <TextView
            android:id="@+id/legendHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-70 dBm"
            android:textColor="#FF000000"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFollow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:layout_marginBottom="72dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFFFFFFF"
        app:tint="#FF000000"
        app:fabSize="mini" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="72dp"
        android:src="@android:drawable/ic_media_play"
        app:backgroundTint="#FFFFFFFF"
        app:tint="#FF000000" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:backgroundTint="#FFFFFFFF"
        app:tint="#FF000000"
        app:fabSize="mini" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRadio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:layout_marginTop="64dp"
        android:src="@android:drawable/ic_menu_preferences"
        app:backgroundTint="#FFFFFFFF"
        app:tint="#FF000000"
        app:fabSize="mini" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
